# Local signing configuration — copy to `signing.env` (git-ignored) and fill in.
# Only identifiers and file paths go here. Secrets stay in the macOS keychain:
#   Azure client secret (only with an app registration):  security add-generic-password -U -a md-reader -s md-reader-azure-client-secret -w
# (the build scripts read it from there when AZURE_CLIENT_SECRET isn't set).

# --- macOS: Developer ID signing (from `security find-identity -v -p codesigning`)
APPLE_SIGNING_IDENTITY="Developer ID Application: Lionsville B.V. (F25LRF5P7Y)"

# --- macOS: notarization with an App Store Connect API key (Users and Access › Integrations › Team Keys)
APPLE_API_KEY=""                                    # Key ID, e.g. 2X9R4HXF34
APPLE_API_ISSUER=""                                 # Issuer ID (UUID)
APPLE_API_KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_${APPLE_API_KEY}.p8"

# --- Windows: Azure Trusted Signing, signed on this Mac with jsign (brew install jsign).
# Auth: leave AZURE_TENANT_ID/AZURE_CLIENT_ID empty to use your own `az login`, or fill them in to
# use an app registration (its secret goes in the keychain, see top).
MDR_AZURE_ENDPOINT="https://weu.codesigning.azure.net"   # region endpoint of your signing account
MDR_AZURE_ACCOUNT=""                                     # Trusted Signing account name
MDR_AZURE_PROFILE=""                                     # certificate profile name
AZURE_TENANT_ID=""                                       # app registration: Directory (tenant) ID
AZURE_CLIENT_ID=""                                       # app registration: Application (client) ID
